#!/usr/bin/env python3
"""foldctl — fold control plane v0 (CLI seed of the board).

Commands:
  tasks                       list tasks with workspace + agent state
  dispatch TEMPLATE PROMPT..  create a task; --repo picks the project
                              (registry name from repos.json), --llm and
                              --model the inference pair
  repos                       list registered projects
  repos add OWNER/NAME        register a work repo; --create makes it on
                              the forge; also wires collaborators +
                              branch protection. [--name <project>]
                              [--review bellwether|human] [--default]
  pause WORKSPACE             freeze the workspace's incus instance (RAM kept,
                              inspectable, instantly resumable)
  resume WORKSPACE            unfreeze
  stop WORKSPACE              graceful stop (end-of-task lifecycle)

Deployment specifics (your Forgejo, your ntfy, repo paths, board URL)
live OUTSIDE this repo in STATE_DIR/fold.env — plain KEY=VALUE lines;
process env overrides it. Keys:
  FOLD_FORGEJO        https://git.example.com
  FOLD_WORK_REPO      owner/repo agents work on
  FOLD_SHEPHERD_REPO  owner/repo shepherds plan from (default: WORK_REPO)
  FOLD_AUTHOR_LOGIN   forge account agents author as (default: fold-alpha)
  FOLD_NTFY           https://ntfy.example.com/fold  (full topic URL)
  FOLD_BOARD_URL      http://<incus-bridge-ip>:7070  (shepherds only)
Plus plain env config:
  FOLD_CREDS       (~/coder-eval/bellwether.env)   # tokens, 0600
"""
import json
import os
import re
import subprocess
import sys
import time
import urllib.parse
import urllib.request

CREDS = os.path.expanduser(
    os.environ.get("FOLD_CREDS", "~/coder-eval/bellwether.env"))
MAX_WORKING = int(os.environ.get("FOLD_MAX_WORKING", "6"))
STATE_DIR = os.path.expanduser(
    os.environ.get("FOLD_STATE_DIR", "~/.local/state/fold"))
MEMSTATS = os.path.join(STATE_DIR, "memstats.jsonl")


def _fold_env():
    conf = {}
    try:
        for line in open(os.path.join(STATE_DIR, "fold.env")):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, _, v = line.partition("=")
                conf[k.strip()] = v.strip()
    except FileNotFoundError:
        pass
    return conf


_CONF = _fold_env()


def conf(name, default=None):
    return os.environ.get(name) or _CONF.get(name) or default


def require(name, why):
    v = conf(name)
    if not v:
        sys.exit(f"{name} is not set (needed for {why}); set it in the "
                 f"environment or in {os.path.join(STATE_DIR, 'fold.env')}")
    return v


NTFY = conf("FOLD_NTFY")  # full topic URL


def _creds_repo_guard():
    """A credentials file inside a checkout of a repo agents work on
    would ship the keys into every agent workspace: REFUSE to run.
    Inside any other git repo it is still one `git add -A` from
    publication: warn loudly, the human decides. Runs on every foldctl
    invocation (the board shells out here per mutation), so a growing
    repo registry is re-checked on each dispatch."""
    if not os.path.exists(CREDS):
        return
    d = os.path.dirname(os.path.abspath(CREDS))
    while not os.path.exists(os.path.join(d, ".git")):
        parent = os.path.dirname(d)
        if parent == d:
            return  # not inside any git repo
        d = parent
    assoc = {v for v in (conf("FOLD_WORK_REPO"), conf("FOLD_SHEPHERD_REPO"))
             if v}
    try:
        rr = json.load(open(os.path.join(STATE_DIR, "repos.json")))
        assoc |= {e.get("repo") for k, e in rr.items()
                  if not k.startswith("_") and isinstance(e, dict)}
        assoc.discard(None)
    except (FileNotFoundError, json.JSONDecodeError):
        pass
    try:
        r = subprocess.run(["git", "-C", d, "remote", "-v"],
                           capture_output=True, text=True)
        remotes = r.stdout if r.returncode == 0 else ""
    except OSError:
        remotes = ""  # no git binary: fall through to the loud warning
    for a in assoc:
        if re.search(rf"[:/]{re.escape(a)}(\.git)?(\s|$)", remotes):
            sys.exit(f"REFUSING to run: credentials file {CREDS} sits "
                     f"inside a checkout of {a} ({d}) — a repo fold "
                     "agents work on. Agents would receive your keys "
                     "with every clone. Move the file somewhere "
                     "unversioned and point FOLD_CREDS at it.")
    print(f"WARNING: credentials file {CREDS} sits inside a git "
          f"repository ({d}). Move it somewhere unversioned and "
          "point FOLD_CREDS at it.", file=sys.stderr)


_creds_repo_guard()


def ntfy(title, message):
    if not NTFY:
        print(f"[ntfy skipped — FOLD_NTFY not set] {title}: {message}",
              file=sys.stderr)
        return
    tok = re.search(r"FOLD_NTFY_TOKEN=(.*)", open(CREDS).read()).group(1).strip()
    req = urllib.request.Request(
        NTFY, data=message.encode(),
        headers={"Authorization": f"Bearer {tok}", "Title": title})
    urllib.request.urlopen(req, timeout=30)


def incus(*args, ok_fail=False):
    r = subprocess.run(["incus", *args], capture_output=True, text=True)
    if r.returncode and not ok_fail:
        sys.exit(f"incus {' '.join(args)}: {r.stderr.strip()}")
    return r


REGISTRY = os.path.join(STATE_DIR, "tasks.json")
IMAGE_ALIAS = "fold-agent-base"


def registry():
    try:
        return json.load(open(REGISTRY))
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def save_registry(reg):
    os.makedirs(STATE_DIR, exist_ok=True)
    json.dump(reg, open(REGISTRY, "w"), indent=1)


def cred(name):
    m = re.search(rf"{name}=(.*)", open(CREDS).read())
    return m.group(1).strip() if m else None


def instance_name(ws):
    return f"fold-{ws.lower()}"


def ensure_profile():
    if incus("profile", "show", "fold-agent", ok_fail=True).returncode == 0:
        return
    incus("profile", "create", "fold-agent")
    incus("profile", "set", "fold-agent", "security.nesting=true",
          "security.syscalls.intercept.mknod=true",
          "security.syscalls.intercept.setxattr=true")
    incus("profile", "device", "add", "fold-agent", "root", "disk",
          "pool=default", "path=/")
    incus("profile", "device", "add", "fold-agent", "eth0", "nic",
          "network=incusbr0", "security.acls=fold-egress")


# Inference is selectable per task from the endpoint registry
# (STATE_DIR/endpoints.json: names -> url, key or key_from, models,
# plus a _default endpoint+model pair). FOLD_LLM_* env still overrides
# everything for one-off runs.
ENDPOINTS_FILE = os.path.join(STATE_DIR, "endpoints.json")


def endpoints():
    try:
        return json.load(open(ENDPOINTS_FILE))
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def resolve_llm(llm=None, model=None):
    """(url, key, model, endpoint_name) for a dispatch."""
    if os.environ.get("FOLD_LLM_URL"):
        m = model or os.environ.get("FOLD_LLM_MODEL")
        if not m:
            sys.exit("FOLD_LLM_URL is set but no model given "
                     "(pass --model or set FOLD_LLM_MODEL)")
        # "proxy-injected" = any non-empty placeholder; use it when a
        # reverse proxy attaches the real credential server-side.
        return (os.environ["FOLD_LLM_URL"],
                os.environ.get("FOLD_LLM_KEY", "proxy-injected"), m, "env")
    eps = endpoints()
    if not eps:
        sys.exit(f"no inference endpoints: create {ENDPOINTS_FILE} "
                 "(names -> url/key/models + a _default pair; see "
                 "docs/QUICKSTART.md) or set FOLD_LLM_URL")
    default = eps.get("_default", {})
    name = llm or default.get("endpoint")
    ep = eps.get(name)
    if not ep:
        sys.exit(f"unknown inference endpoint {name!r}; "
                 f"known: {[k for k in eps if not k.startswith('_')]}")
    m = model or (default.get("model") if name == default.get("endpoint")
                  else None) or (ep.get("models") or ["?"])[0]
    if ep.get("models") and m not in ep["models"]:
        sys.exit(f"model {m!r} not offered by {name}; has: {ep['models']}")
    key = ep.get("key") or (cred(ep["key_from"]) if ep.get("key_from")
                            else "proxy-injected")
    return ep["url"], key, m, name


# Work repos are a registry too (STATE_DIR/repos.json: project name ->
# {repo: owner/name, review: policy}, plus "_default"). Same principle
# as endpoints: the agent plane picks project NAMES, never arbitrary
# clone targets.
REPOS_FILE = os.path.join(STATE_DIR, "repos.json")


def repos():
    try:
        return json.load(open(REPOS_FILE))
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def resolve_repo(project=None):
    """(project_name, owner/repo) for a dispatch."""
    reg = repos()
    if not project:
        project = reg.get("_default")
        if not project:
            # pre-registry deployments: fold.env names a single repo
            path = conf("FOLD_WORK_REPO")
            if path:
                return path.rsplit("/", 1)[-1], path
            sys.exit(f"no work repo: create {REPOS_FILE} (foldctl repos "
                     "add ...) or set FOLD_WORK_REPO in fold.env")
    entry = reg.get(project)
    if not entry:
        sys.exit(f"unknown project {project!r}; known: "
                 f"{[k for k in reg if not k.startswith('_')]}")
    return project, entry["repo"]


def forgejo_api(path, method="GET", body=None, token=None):
    req = urllib.request.Request(
        f"{require('FOLD_FORGEJO', 'repo management')}/api/v1{path}",
        method=method,
        data=json.dumps(body).encode() if body is not None else None,
        headers={"Authorization": f"token {token}",
                 "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=30) as r:
        data = r.read()
        return json.loads(data) if data else {}


def cmd_repos(rest):
    if rest and rest[0] == "add":
        rest = rest[1:]
        path, create, review, name, default = None, False, "bellwether", None, False
        while rest:
            a, rest = rest[0], rest[1:]
            if a == "--create":
                create = True
            elif a == "--default":
                default = True
            elif a == "--review":
                review, rest = rest[0], rest[1:]
            elif a == "--name":
                name, rest = rest[0], rest[1:]
            else:
                path = a
        if not path or "/" not in path:
            sys.exit("usage: foldctl repos add <owner/name> [--create] "
                     "[--name <project>] [--review bellwether|human] "
                     "[--default]")
        admin = cred("FOLD_SETUP_TOKEN")
        if not admin:
            sys.exit("FOLD_SETUP_TOKEN missing from creds file")
        rname = path.rsplit("/", 1)[-1]
        if create:
            # /user/repos creates under the TOKEN's account regardless of
            # the owner typed — creating elsewhere would register a path
            # that doesn't match what was made. Ownership enforcement IS
            # the token's privileges; this check just makes it legible.
            me = forgejo_api("/user", token=admin).get("login", "")
            owner = path.split("/", 1)[0]
            if owner != me:
                sys.exit(f"--create makes repos under the forge token's "
                         f"account ({me}); cannot create {path}. Register "
                         "an existing repo instead, or create it as "
                         f"{me}/{rname}.")
            forgejo_api("/user/repos", "POST",
                        {"name": rname, "private": True, "auto_init": True,
                         "default_branch": "master"}, admin)
            print(f"created {path}")
        login = conf("FOLD_AUTHOR_LOGIN", "fold-alpha")
        for collab in (login, "bellwether"):
            forgejo_api(f"/repos/{path}/collaborators/{collab}", "PUT",
                        {"permission": "write"}, admin)
        print(f"collaborators: {login}, bellwether (write)")
        # Merge policy lives in the forge: approval required, no direct
        # pushes. Idempotence: the forge rejects a duplicate rule.
        try:
            forgejo_api(f"/repos/{path}/branch_protections", "POST",
                        {"branch_name": "master", "rule_name": "master",
                         "required_approvals": 1,
                         "block_on_rejected_reviews": True,
                         "enable_push": False}, admin)
            print("branch protection: master, 1 approval, no direct push")
        except urllib.error.HTTPError as e:
            print(f"branch protection not added (HTTP {e.code} — "
                  "may already exist)")
        reg = repos()
        key = name or rname
        reg[key] = {"repo": path, "review": review}
        if default or "_default" not in reg:
            reg["_default"] = key
        os.makedirs(STATE_DIR, exist_ok=True)
        json.dump(reg, open(REPOS_FILE, "w"), indent=1)
        print(f"registered project {key} -> {path} (review={review}"
              + (", default" if reg["_default"] == key else "") + ")")
        return
    reg = repos()
    if not any(not k.startswith("_") for k in reg):
        sys.exit(f"no projects registered; see foldctl repos add")
    d = reg.get("_default")
    for k, v in sorted(reg.items()):
        if k.startswith("_"):
            continue
        print(f"{k:20} {v['repo']:42} review={v.get('review', 'bellwether')}"
              + ("  (default)" if k == d else ""))


def opencode_config(url, key, model):
    return json.dumps({
        "$schema": "https://opencode.ai/config.json",
        "permission": {"edit": "allow", "bash": "allow", "webfetch": "allow"},
        "provider": {"fold": {
            "npm": "@ai-sdk/openai-compatible", "name": "fold",
            "options": {"baseURL": url, "apiKey": key},
            "models": {model: {"name": model}}}},
        "model": f"fold/{model}",
    })


def native_dispatch(flavor, prompt, mem_gib=None, ctx=None,
                    llm=None, model=None, repo=None):
    """Provision a fold-native agent from the golden image."""
    ensure_profile()
    url, key, model, ep_name = resolve_llm(llm, model)
    project, work_repo = resolve_repo(repo)
    name = f"task-{int(time.time()) % 100000}"
    inst = f"fold-{name}"
    author = cred("FOLD_ALPHA_TOKEN")
    forge = require("FOLD_FORGEJO", "dispatch")
    login = conf("FOLD_AUTHOR_LOGIN", "fold-alpha")
    forge_netloc = urllib.parse.urlparse(forge).netloc
    env = {
        "FORGEJO_URL": forge,
        "FORGEJO_REPO": work_repo,
        "FORGEJO_TOKEN": author,
        "NTFY_URL": NTFY.rsplit("/", 1)[0] if NTFY else "",
        "NTFY_TOKEN": cred("FOLD_NTFY_TOKEN") or "",
        "FOLD_WORKSPACE": name,
        "GIT_AUTHOR_NAME": login,
        "GIT_AUTHOR_EMAIL": f"{login}@{forge_netloc}",
        "GIT_COMMITTER_NAME": login,
        "GIT_COMMITTER_EMAIL": f"{login}@{forge_netloc}",
    }
    repo = f"https://{login}:{author}@{forge_netloc}/{work_repo}.git"
    if flavor == "shepherd":
        shep_repo = conf("FOLD_SHEPHERD_REPO", work_repo)
        repo = f"https://{login}:{author}@{forge_netloc}/{shep_repo}.git"
        env.update(FOLD_BOARD_URL=require("FOLD_BOARD_URL",
                                          "shepherd dispatch"),
                   FOLD_BOARD_TOKEN=cred("FOLD_BOARD_TOKEN"),
                   FOLD_CTX=name)
    need = mem_gib or learned_footprint_gib(flavor) or 2.0
    incus("init", IMAGE_ALIAS, inst, "--profile", "fold-agent")
    incus("storage", "volume", "create", "default", f"{inst}-home")
    incus("config", "device", "add", inst, "home", "disk",
          "pool=default", f"source={inst}-home", "path=/home/coder")
    incus("config", "set", inst,
          f"limits.memory={max(2, int(need * 2))}GiB",
          "limits.cpu=2")
    for k, v in (("prompt", prompt), ("repo", repo),
                 ("env", json.dumps(env)),
                 ("opencode_config", opencode_config(url, key, model))):
        # key=value as ONE argument: a value starting with "--" (e.g. a
        # prompt that begins with a mistyped flag) would otherwise be
        # parsed by the incus CLI as a flag and abort mid-provision.
        incus("config", "set", inst, f"user.fold_{k}={v}")
    incus("start", inst)
    reg = registry()
    reg[name] = {"flavor": flavor, "created": int(time.time()),
                 "prompt": prompt, "ctx": ctx,
                 "llm": ep_name, "model": model,
                 "project": project, "repo": work_repo}
    save_registry(reg)
    if ctx:
        ctx_file = os.path.join(STATE_DIR, "ctx.json")
        try:
            m = json.load(open(ctx_file))
        except (FileNotFoundError, json.JSONDecodeError):
            m = {}
        m[name] = ctx
        json.dump(m, open(ctx_file, "w"), indent=1)
    print(f"dispatched {name} (native {flavor}, instance {inst}, "
          f"mem cap {max(2, int(need * 2))}GiB"
          + (f", ctx {ctx}" if ctx else "") + ")")


def cmd_tasks():
    nat = native_running()
    for name, meta in sorted(registry().items(),
                             key=lambda kv: -kv[1]["created"]):
        st = nat.get(name, "STOPPED")
        print(f"{name:24} ws={st.lower():10} native/{meta['flavor']}")


def host_available_gib():
    for line in open("/proc/meminfo"):
        if line.startswith("MemAvailable:"):
            return int(line.split()[1]) / 2**20
    return 0.0


def learned_footprint_gib(template):
    """Observed P90 of anon peaks for this template; None if no history."""
    try:
        peaks = [json.loads(l)["anon_peak_gib"] for l in open(MEMSTATS)
                 if json.loads(l).get("template") == template]
    except FileNotFoundError:
        return None
    if not peaks:
        return None
    peaks.sort()
    return peaks[min(len(peaks) - 1, int(len(peaks) * 0.9))]


def record_memstats(ws, template=""):
    """Read the instance's peak/anon memory before it stops; append to log."""
    inst = instance_name(ws)
    r = incus("exec", inst, "--", "sh", "-c",
              "cat /sys/fs/cgroup/memory.peak 2>/dev/null; "
              "grep '^anon ' /sys/fs/cgroup/memory.stat", ok_fail=True)
    if r.returncode:
        return None
    lines = r.stdout.split()
    try:
        peak, anon = int(lines[0]), int(lines[2])
    except (IndexError, ValueError):
        return None
    os.makedirs(STATE_DIR, exist_ok=True)
    rec = {"t": int(time.time()), "workspace": ws, "template": template,
           "peak_gib": round(peak / 2**30, 2),
           "anon_peak_gib": round(anon / 2**30, 2)}
    with open(MEMSTATS, "a") as f:
        f.write(json.dumps(rec) + "\n")
    return rec


def native_running():
    r = incus("list", "--format", "csv", "-c", "ns", ok_fail=True)
    out = {}
    for line in (r.stdout or "").splitlines():
        name, _, status = line.partition(",")
        if name.startswith("fold-task-"):
            out[name[5:]] = status
    return out


def cmd_dispatch(template, prompt, mem_gib=None, ctx=None,
                 llm=None, model=None, repo=None):
    if template not in ("agent", "shepherd"):
        sys.exit(f"unknown template {template!r}; "
                 "native templates: agent, shepherd")
    # Admission control: inference slots (max working) + RAM headroom.
    # Frozen instances hold no slot: zero CPU, zero inference.
    nat = native_running()
    working = sum(1 for st in nat.values() if st == "RUNNING")
    need = mem_gib or learned_footprint_gib(template) or 2.0
    avail = host_available_gib()
    if working >= MAX_WORKING:
        sys.exit(f"admission: {working} already working (max {MAX_WORKING})")
    if avail - 2.0 < need:
        sys.exit(f"admission: expects {need:.1f} GiB, host has "
                 f"{avail:.1f} GiB (2 GiB reserve)")
    return native_dispatch(template, prompt, mem_gib=mem_gib, ctx=ctx,
                           llm=llm, model=model, repo=repo)


def _instance_ip(inst):
    r = incus("query", f"/1.0/instances/{inst}?recursion=1", ok_fail=True)
    if r.returncode:
        return None
    eth0 = ((json.loads(r.stdout).get("state") or {})
            .get("network") or {}).get("eth0") or {}
    for a in eth0.get("addresses", []):
        if a["family"] == "inet":
            return a["address"]
    return None


def _agentapi(ip, path, body=None, timeout=10):
    req = urllib.request.Request(
        f"http://{ip}:3284{path}",
        data=json.dumps(body).encode() if body is not None else None,
        headers={"Content-Type": "application/json", "Host": "localhost"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def cmd_pause(ws):
    """Interrupt, settle, then freeze.

    Freezing mid-generation severs the agent's inference stream; on
    resume it spins on the broken connection (learned 2026-09-22 from
    the first shepherd). So: never ice a mind mid-sentence — send ESC,
    wait for the agent to come to rest, then freeze.
    """
    inst = instance_name(ws)
    ip = _instance_ip(inst)
    if ip:
        try:
            if _agentapi(ip, "/status")["status"] != "stable":
                print(f"{ws}: agent is mid-generation — interrupting first…")
                _agentapi(ip, "/message",
                          {"content": "\x1b", "type": "raw"})
                deadline = time.time() + 45
                while time.time() < deadline:
                    if _agentapi(ip, "/status")["status"] == "stable":
                        print(f"{ws}: agent at rest")
                        break
                    time.sleep(3)
                else:
                    print(f"{ws}: WARNING — no resting point reached in "
                          "45s; freezing anyway. If resume spins, "
                          "prefer 'stop'.")
        except Exception:
            pass  # no agentapi (not an agent workspace, or already quiet)
    incus("pause", inst)
    print(f"{ws}: frozen (RAM preserved; 'foldctl resume {ws}' to continue)")


def cmd_resume(ws):
    incus("resume", instance_name(ws))
    print(f"{ws}: resumed")


def cmd_start(ws):
    incus("start", f"fold-{ws.lower()}")
    print(f"{ws}: started")


def cmd_stop(ws):
    # End-of-task lifecycle, not failure handling: home volume persists.
    rec = record_memstats(ws, registry().get(ws, {}).get("flavor", "agent"))
    incus("stop", f"fold-{ws.lower()}", ok_fail=True)
    peak = f", anon peak {rec['anon_peak_gib']} GiB recorded" if rec else ""
    print(f"{ws}: stopped{peak}")


def cmd_memstats():
    try:
        rows = [json.loads(l) for l in open(MEMSTATS)]
    except FileNotFoundError:
        sys.exit("no memory stats recorded yet")
    for r in rows[-20:]:
        print(f"{r['workspace']:24} {r['template']:14} "
              f"anon_peak={r['anon_peak_gib']:>5} GiB  peak={r['peak_gib']:>5} GiB")


def main():
    args = sys.argv[1:]
    if not args:
        sys.exit(__doc__)
    cmd, rest = args[0], args[1:]
    if cmd == "tasks":
        cmd_tasks()
    elif cmd == "memstats":
        cmd_memstats()
    elif cmd == "repos":
        cmd_repos(rest)
    elif cmd == "dispatch" and len(rest) >= 2:
        # Flags may appear before or after the template word; an unknown
        # --flag is an error, never silently part of the prompt.
        opts, pos = {}, []
        known = {"--mem", "--ctx", "--llm", "--model", "--repo"}
        while rest:
            if len(pos) == 2:
                # the prompt has begun: everything left is prose, even
                # words that look like flags (prompts quote dispatch
                # syntax, e.g. the shepherd contract examples)
                pos[1] = pos[1] + " " + " ".join(rest)
                rest = []
            elif rest[0] in known and len(rest) >= 2:
                opts[rest[0][2:]], rest = rest[1], rest[2:]
            elif rest[0].startswith("--"):
                sys.exit(f"unknown dispatch flag {rest[0]!r} "
                         f"(known: {sorted(known)})")
            else:
                pos.append(rest[0])
                rest = rest[1:]
        if len(pos) < 2:
            sys.exit("dispatch needs TEMPLATE and PROMPT")
        cmd_dispatch(pos[0], pos[1],
                     mem_gib=float(opts["mem"]) if "mem" in opts else None,
                     ctx=opts.get("ctx"), llm=opts.get("llm"),
                     model=opts.get("model"), repo=opts.get("repo"))
    elif cmd in ("pause", "resume", "stop", "start") and len(rest) == 1:
        {"pause": cmd_pause, "resume": cmd_resume,
         "stop": cmd_stop, "start": cmd_start}[cmd](rest[0])
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
